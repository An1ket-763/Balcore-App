# WalletConnect Cloud project ID (https://cloud.reown.com)
# Required for the WalletConnect / RainbowKit wallet list.
# Without it the app falls back to browser-extension wallets only.
VITE_WALLETCONNECT_PROJECT_ID=

# Snowtrace (Fuji) API key — optional.
# The free tier works without one; add a key only if you hit rate limits.
# https://snowtrace.io/apis
VITE_SNOWTRACE_API_KEY=
