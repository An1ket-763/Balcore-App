# Network selection: "mainnet" (Avalanche C-Chain, REAL funds and gas) or
# "testnet" (Avalanche Fuji). Defaults to mainnet; set VITE_CHAIN_ENV=testnet
# to opt into Fuji for local development only.
VITE_CHAIN_ENV=mainnet

# Privy app ID (https://dashboard.privy.io -> your app -> Settings). REQUIRED.
# Privy runs sign-in: email / Google (Privy creates an embedded wallet for the
# user) or an existing wallet. Public identifier, safe to expose to the browser.
# Also add every domain the app runs on (localhost, preview, production) under
# the app's allowed domains in the Privy dashboard, or sign-in is refused there.
VITE_PRIVY_APP_ID=

# WalletConnect Cloud project ID (https://cloud.reown.com) — optional.
# Passed to Privy for the WalletConnect (mobile wallet) option.
VITE_WALLETCONNECT_PROJECT_ID=

# Snowtrace API key — optional on testnet.
# The mainnet API may rate-limit unauthenticated requests; add a key if needed.
# https://snowtrace.io/apis
VITE_SNOWTRACE_API_KEY=

# Arms the REAL CCTP bridge (burn + mint). Leave unset while the bridge is
# still being built: depositForBurn destroys USDC before the mint step exists,
# so a real transfer could be stranded mid-flight. Set to true on testnet only
# until the full path is finished.
VITE_BRIDGE_LIVE=
