# Network selection: "mainnet" (Avalanche C-Chain, REAL funds and gas) or
# "testnet" (Avalanche Fuji). Defaults to testnet so real funds are opt-in.
VITE_CHAIN_ENV=testnet

# WalletConnect Cloud project ID (https://cloud.reown.com)
# Required for the WalletConnect / RainbowKit wallet list.
# Without it the app falls back to browser-extension wallets only.
VITE_WALLETCONNECT_PROJECT_ID=

# Snowtrace API key — optional on testnet.
# The mainnet API may rate-limit unauthenticated requests; add a key if needed.
# https://snowtrace.io/apis
VITE_SNOWTRACE_API_KEY=
